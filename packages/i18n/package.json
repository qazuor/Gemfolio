{
  "name": "@gemfolio/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./messages/*": {
      "types": "./src/messages/*.json",
      "default": "./src/messages/*.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "paraglide-js compile --project ./project.inlang"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^1.11.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
