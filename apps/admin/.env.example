# ===========================================
# Gemfolio Admin (Next.js) - Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://gemfolio:gemfolio_dev@localhost:5434/gemfolio_db

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@gemfolio.com

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gemfolio
R2_PUBLIC_URL=

# Public environment variables (exposed to browser)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=Gemfolio Admin
NEXT_PUBLIC_WEB_URL=http://localhost:4321
