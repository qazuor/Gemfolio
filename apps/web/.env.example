# ===========================================
# Gemfolio Web (Astro) - Environment Configuration
# ===========================================

# API endpoint for the admin/backend
PUBLIC_API_URL=http://localhost:3000/api

# Site URL
PUBLIC_SITE_URL=http://localhost:4321

# Site name and branding
PUBLIC_SITE_NAME=Gemfolio
PUBLIC_SITE_DESCRIPTION=Catálogo de joyería fina

# PWA
PUBLIC_ENABLE_PWA=true

# Analytics
PUBLIC_GOOGLE_ANALYTICS_ID=
