---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WishlistPage from '@/components/react/wishlist/WishlistPage';
---

<BaseLayout title="Mis Favoritos" description="Tu lista de productos favoritos" noIndex>
  <!-- Breadcrumb -->
  <nav class="border-b">
    <div class="container mx-auto px-4 py-3">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li>
          <a href="/" class="hover:text-foreground">Inicio</a>
        </li>
        <li>/</li>
        <li class="text-foreground">Favoritos</li>
      </ol>
    </div>
  </nav>

  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <h1 class="mb-8 font-heading text-2xl font-bold md:text-3xl flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
        Mis Favoritos
      </h1>
      <WishlistPage client:load />
    </div>
  </section>
</BaseLayout>
