---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductGrid from '@/components/astro/product/ProductGrid.astro';
import BundleCard from '@/components/astro/bundle/BundleCard.astro';
import { getFeaturedProducts, getNewProducts, getCategories, getBundles } from '@/lib/api';

const [featuredProducts, newProducts, categories, bundles] = await Promise.all([
  getFeaturedProducts(8),
  getNewProducts(4),
  getCategories(),
  getBundles(4),
]);

// Map categories with icons
const categoryIcons: Record<string, string> = {
  anillos: '💍',
  collares: '📿',
  pulseras: '⌚',
  aretes: '✨',
  pendientes: '✨',
  dijes: '🔮',
  default: '💎',
};
---

<BaseLayout title="Inicio">
  <!-- Hero Section -->
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
      <h1 class="mb-6 font-heading text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
        Joyería Artesanal
        <span class="block text-primary">Hecha con Pasión</span>
      </h1>
      <p class="mb-8 max-w-2xl text-lg text-muted-foreground md:text-xl">
        Descubre nuestra exclusiva colección de joyas artesanales. Piezas únicas diseñadas para
        brillar en cada momento especial.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/catalogo"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Ver Catálogo
        </a>
        <a
          href="/ofertas"
          class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-8 py-3 font-medium transition-colors hover:bg-accent"
        >
          Ver Ofertas
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="border-y bg-muted/30 py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold">Categorías</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          categories.slice(0, 8).map((category) => (
            <a
              href={`/categoria/${category.slug}`}
              class="group flex flex-col items-center rounded-lg border bg-background p-8 transition-all hover:border-primary hover:shadow-lg"
            >
              {category.image ? (
                <img
                  src={category.image}
                  alt={category.name}
                  class="mb-4 h-16 w-16 rounded-full object-cover"
                />
              ) : (
                <span class="mb-4 text-5xl">
                  {categoryIcons[category.slug] || categoryIcons.default}
                </span>
              )}
              <span class="font-medium group-hover:text-primary">{category.name}</span>
              {category.productCount !== undefined && (
                <span class="mt-1 text-sm text-muted-foreground">
                  {category.productCount} productos
                </span>
              )}
            </a>
          ))
        }
      </div>
      {categories.length > 8 && (
        <div class="mt-8 text-center">
          <a
            href="/catalogo"
            class="text-sm text-primary hover:underline"
          >
            Ver todas las categorías →
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Featured Products -->
  {featuredProducts.length > 0 && (
    <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="font-heading text-3xl font-bold">Productos Destacados</h2>
          <a href="/catalogo?tag=destacado" class="text-sm text-primary hover:underline">
            Ver todos →
          </a>
        </div>
        <ProductGrid products={featuredProducts} columns={4} />
      </div>
    </section>
  )}

  <!-- New Products -->
  {newProducts.length > 0 && (
    <section class="border-t bg-muted/30 py-16">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="font-heading text-3xl font-bold">Novedades</h2>
          <a href="/catalogo?tag=nuevo" class="text-sm text-primary hover:underline">
            Ver todas →
          </a>
        </div>
        <ProductGrid products={newProducts} columns={4} />
      </div>
    </section>
  )}

  <!-- Bundles -->
  {bundles.length > 0 && (
    <section class="border-t py-16">
      <div class="container mx-auto px-4">
        <div class="mb-8 text-center">
          <h2 class="mb-2 font-heading text-3xl font-bold">Bundles Especiales</h2>
          <p class="text-muted-foreground">
            Combina tus piezas favoritas y ahorra
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {bundles.map((bundle) => (
            <BundleCard bundle={bundle} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="border-t bg-primary py-16 text-primary-foreground">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold">¿Buscas algo especial?</h2>
      <p class="mb-8 text-primary-foreground/80">
        Contáctanos para diseños personalizados y piezas únicas.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center rounded-lg bg-background px-8 py-3 font-medium text-foreground transition-colors hover:bg-background/90"
      >
        Contáctanos
      </a>
    </div>
  </section>
</BaseLayout>
