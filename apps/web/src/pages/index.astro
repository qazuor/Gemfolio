---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio">
  <!-- Hero Section -->
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
      <h1 class="mb-6 font-heading text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
        Joyería Artesanal
        <span class="block text-primary">Hecha con Pasión</span>
      </h1>
      <p class="mb-8 max-w-2xl text-lg text-muted-foreground md:text-xl">
        Descubre nuestra exclusiva colección de joyas artesanales. Piezas únicas diseñadas para
        brillar en cada momento especial.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/catalogo"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Ver Catálogo
        </a>
        <a
          href="/ofertas"
          class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-8 py-3 font-medium transition-colors hover:bg-accent"
        >
          Ver Ofertas
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="border-y bg-muted/30 py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold">Categorías</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { name: 'Anillos', href: '/categoria/anillos', icon: '💍' },
            { name: 'Collares', href: '/categoria/collares', icon: '📿' },
            { name: 'Pulseras', href: '/categoria/pulseras', icon: '⌚' },
            { name: 'Aretes', href: '/categoria/aretes', icon: '✨' },
          ].map((category) => (
            <a
              href={category.href}
              class="group flex flex-col items-center rounded-lg border bg-background p-8 transition-all hover:border-primary hover:shadow-lg"
            >
              <span class="mb-4 text-5xl">{category.icon}</span>
              <span class="font-medium group-hover:text-primary">{category.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured Section Placeholder -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold">Productos Destacados</h2>
      <p class="text-center text-muted-foreground">
        Próximamente: Los productos destacados se cargarán desde la API.
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="border-t bg-primary py-16 text-primary-foreground">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold">¿Buscas algo especial?</h2>
      <p class="mb-8 text-primary-foreground/80">
        Contáctanos para diseños personalizados y piezas únicas.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center rounded-lg bg-background px-8 py-3 font-medium text-foreground transition-colors hover:bg-background/90"
      >
        Contáctanos
      </a>
    </div>
  </section>
</BaseLayout>
