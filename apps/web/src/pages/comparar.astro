---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComparatorPage from '@/components/react/comparator/ComparatorPage';
---

<BaseLayout title="Comparar Productos" description="Compara productos lado a lado" noIndex>
  <!-- Breadcrumb -->
  <nav class="border-b">
    <div class="container mx-auto px-4 py-3">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li>
          <a href="/" class="hover:text-foreground">Inicio</a>
        </li>
        <li>/</li>
        <li class="text-foreground">Comparar</li>
      </ol>
    </div>
  </nav>

  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <h1 class="mb-8 font-heading text-2xl font-bold md:text-3xl flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
          <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
          <path d="M7 21h10"/>
          <path d="M12 3v18"/>
          <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
        </svg>
        Comparar Productos
      </h1>
      <ComparatorPage client:load />
    </div>
  </section>
</BaseLayout>
