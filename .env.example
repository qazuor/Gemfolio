# ===========================================
# DATABASE
# ===========================================
# Local development (Docker)
DATABASE_URL="postgresql://gemfolio:gemfolio_dev@localhost:5432/gemfolio_db"

# Production (Neon)
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ===========================================
# AUTHENTICATION (Better Auth)
# ===========================================
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars-here"
BETTER_AUTH_URL="http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===========================================
# STORAGE (Cloudflare R2)
# ===========================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="gemfolio"
R2_PUBLIC_URL=""

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=""
EMAIL_FROM="Gemfolio <noreply@gemfolio.com>"

# ===========================================
# APPLICATION URLs
# ===========================================
# Web (public catalog)
NEXT_PUBLIC_WEB_URL="http://localhost:4321"

# Admin panel
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# API (served from admin)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ===========================================
# PWA & PUSH NOTIFICATIONS
# ===========================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
ENABLE_PWA="true"
ENABLE_PUSH_NOTIFICATIONS="false"

# ===========================================
# PAYMENTS (Mercado Pago) - for v1.1
# ===========================================
# MERCADOPAGO_PUBLIC_KEY=""
# MERCADOPAGO_ACCESS_TOKEN=""

# ===========================================
# OPTIONAL
# ===========================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=""

# Sentry
# SENTRY_DSN=""

# Feature Flags
ENABLE_ANALYTICS="false"
